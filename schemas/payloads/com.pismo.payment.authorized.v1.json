{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "com.pismo.payment.authorized.v1",
  "type": "object",
  "required": ["transaction_id", "amount", "currency"],
  "properties": {
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    }
  },
  "additionalProperties": false
}
